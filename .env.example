# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real keys.

# Google Cloud API key with the "Street View Static API" enabled, used to
# show a real photo on comparable-sale cards. Create a project at
# https://console.cloud.google.com, enable Street View Static API, and
# generate an API key restricted to that API.
# Optional: comp cards fall back to a text placeholder when this is unset.
VITE_GOOGLE_MAPS_API_KEY=
